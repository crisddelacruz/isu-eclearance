<%- include('../layouts/app-top', { title: title, active: 'audit' }) %>

<div class="page-head">
  <h1>Audit logs</h1>
  <p>A record of important actions. <%= total %> entr<%= total === 1 ? 'y' : 'ies' %>.</p>
</div>

<section class="card">
  <form class="filters" method="get" action="/admin/audit" role="search">
    <div class="field grow">
      <label for="q">Search</label>
      <input class="input" type="search" id="q" name="q" value="<%= q %>" placeholder="Action, details, or user email" maxlength="60" />
    </div>
    <button class="btn btn-primary btn-sm" type="submit">Search</button>
    <% if (q) { %><a class="btn btn-outline btn-sm" href="/admin/audit">Clear</a><% } %>
  </form>

  <% if (!rows.length) { %>
    <div class="empty"><%- icon('clipboard') %><h4>No entries</h4></div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>When</th><th>Who</th><th>Action</th><th>Details</th><th>IP address</th></tr></thead>
        <tbody>
          <% rows.forEach(function (a) { %>
            <tr>
              <td class="nowrap"><%= fmtDateTime(a.created_at) %></td>
              <td><%= a.first_name ? a.first_name + ' ' + a.last_name : 'Guest' %><% if (a.email) { %><span class="sub"><%= a.email %></span><% } %></td>
              <td><strong class="mono"><%= a.action %></strong></td>
              <td><%= a.details || '—' %></td>
              <td class="mono"><%= a.ip_address || '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('_pager', { page: page, pages: pages, qs: qs }) %>
  <% } %>
</section>

<%- include('../layouts/app-bottom') %>