<%- include('../layouts/app-top', { title: title, active: 'users' }) %>
<%
  const bad = (k) => (errors[k] ? ' is-invalid' : '');
  const msg = (k) => (errors[k] ? '<p class="field-error">' + errors[k] + '</p>' : '');
  const years = ['1st Year', '2nd Year', '3rd Year', '4th Year', '5th Year', '6th Year'];
  const action = isEdit ? '/admin/users/' + userRow.id : '/admin/users';
%>

<div class="page-head">
  <a class="link-more" href="/admin/users">&larr; Back to Users</a>
  <h1 style="margin-top:6px"><%= isEdit ? 'Edit user' : 'Add user' %></h1>
  <p><%= isEdit ? 'Update the account details. The role cannot be changed.' : 'The user must change the password at first login.' %></p>
</div>

<% if (Object.keys(errors).length) { %>
  <div class="alert alert-error" role="alert">Please fix the highlighted fields below.</div>
<% } %>

<section class="card form-card">
  <form method="post" action="<%= action %>" data-once novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="field">
      <label for="role">Role</label>
      <% if (isEdit) { %>
        <select class="input" id="role" disabled><option value="<%= values.role %>"><%= values.role.charAt(0).toUpperCase() + values.role.slice(1) %></option></select>
      <% } else { %>
        <select class="input<%= bad('role') %>" id="role" name="role" required>
          <option value="student" <%= values.role === 'student' ? 'selected' : '' %>>Student</option>
          <option value="signatory" <%= values.role === 'signatory' ? 'selected' : '' %>>Signatory (instructor or office staff)</option>
          <option value="admin" <%= values.role === 'admin' ? 'selected' : '' %>>Administrator</option>
        </select>
        <%- msg('role') %>
      <% } %>
    </div>

    <h3 class="section-title">Personal details</h3>
    <div class="grid-2">
      <div class="field">
        <label for="first_name">First name</label>
        <input class="input<%= bad('first_name') %>" type="text" id="first_name" name="first_name" value="<%= values.first_name || '' %>" required />
        <%- msg('first_name') %>
      </div>
      <div class="field">
        <label for="middle_name">Middle name <span class="opt">(optional)</span></label>
        <input class="input<%= bad('middle_name') %>" type="text" id="middle_name" name="middle_name" value="<%= values.middle_name || '' %>" />
        <%- msg('middle_name') %>
      </div>
    </div>
    <div class="grid-2">
      <div class="field">
        <label for="last_name">Last name</label>
        <input class="input<%= bad('last_name') %>" type="text" id="last_name" name="last_name" value="<%= values.last_name || '' %>" required />
        <%- msg('last_name') %>
      </div>
      <div class="field">
        <label for="suffix">Suffix <span class="opt">(optional)</span></label>
        <input class="input<%= bad('suffix') %>" type="text" id="suffix" name="suffix" value="<%= values.suffix || '' %>" placeholder="Jr., III" />
        <%- msg('suffix') %>
      </div>
    </div>

    <h3 class="section-title">Account</h3>
    <div class="grid-2">
      <div class="field">
        <label for="email">Email address</label>
        <input class="input<%= bad('email') %>" type="email" id="email" name="email" value="<%= values.email || '' %>" required />
        <%- msg('email') %>
      </div>
      <div class="field">
        <label for="id_number">ID number <span class="opt" data-roles="signatory admin">(optional)</span></label>
        <input class="input<%= bad('id_number') %>" type="text" id="id_number" name="id_number" value="<%= values.id_number || '' %>" placeholder="e.g. 2026-00123 or EMP-0123" />
        <%- msg('id_number') %>
      </div>
    </div>

    <% if (!isEdit) { %>
      <div class="field">
        <label for="password">Temporary password <span class="opt">(optional)</span></label>
        <input class="input<%= bad('password') %>" type="text" id="password" name="password" autocomplete="off" placeholder="Leave empty to generate one" />
        <%- msg('password') %>
        <p class="hint">If you leave it empty, a random password is generated and shown once after you save.</p>
      </div>
    <% } %>

    <div data-roles="student signatory">
      <h3 class="section-title">College and program</h3>
      <div class="field">
        <label for="college_id">College</label>
        <select class="input<%= bad('college_id') %>" id="college_id" name="college_id">
          <option value="">Select a college</option>
          <% colleges.forEach(function (c) { %><option value="<%= c.id %>" <%= String(values.college_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %>
        </select>
        <%- msg('college_id') %>
      </div>
      <div class="field">
        <label for="program_id">Program</label>
        <select class="input<%= bad('program_id') %>" id="program_id" name="program_id" data-selected="<%= values.program_id || '' %>">
          <option value="">Select a college first</option>
          <% programs.forEach(function (p) { %><option value="<%= p.id %>" data-college="<%= p.college_id %>"><%= p.name %></option><% }) %>
        </select>
        <%- msg('program_id') %>
        <p class="hint" data-roles="signatory">College Dean: choose the college. Program Chairperson: choose the college and the program. Instructors: choose their college.</p>
      </div>
    </div>

    <div data-roles="student">
      <div class="field">
        <label for="year_level">Year level</label>
        <select class="input<%= bad('year_level') %>" id="year_level" name="year_level">
          <option value="">Select year level</option>
          <% years.forEach(function (y, i) { %><option value="<%= i + 1 %>" <%= String(values.year_level) === String(i + 1) ? 'selected' : '' %>><%= y %></option><% }) %>
        </select>
        <%- msg('year_level') %>
      </div>
    </div>

    <div data-roles="signatory">
      <h3 class="section-title">Office</h3>
      <div class="field">
        <label for="office_id">Office</label>
        <select class="input<%= bad('office_id') %>" id="office_id" name="office_id">
          <option value="">Select an office</option>
          <% offices.forEach(function (o) { %><option value="<%= o.id %>" <%= String(values.office_id) === String(o.id) ? 'selected' : '' %>><%= o.name %></option><% }) %>
        </select>
        <%- msg('office_id') %>
      </div>
      <div class="field">
        <label for="position_title">Position title <span class="opt">(printed under the signature)</span></label>
        <input class="input<%= bad('position_title') %>" type="text" id="position_title" name="position_title" value="<%= values.position_title || '' %>" placeholder="e.g. University Librarian" />
        <%- msg('position_title') %>
      </div>
    </div>

    <div class="form-actions">
      <button class="btn btn-primary" type="submit"><%= isEdit ? 'Save changes' : 'Create account' %></button>
      <a class="btn btn-outline" href="/admin/users">Cancel</a>
    </div>
  </form>
</section>

<script src="/js/admin.js" defer></script>
<%- include('../layouts/app-bottom') %>