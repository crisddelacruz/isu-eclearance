<%- include('../partials/head', { title: title, bodyClass: 'verify-page', extraCss: '/css/verify.css' }) %>
<%- include('../partials/verify-header') %>
<%
  const R = sheet ? sheet.request : null;
  const S = sheet ? sheet.student : null;
  const yrs = ['1st Year', '2nd Year', '3rd Year', '4th Year', '5th Year', '6th Year'];
  const kind = !sheet ? 'bad' : (R.status === 'completed' ? 'ok' : 'warn');
%>

<main class="v-main">
  <% if (!sheet) { %>
    <div class="v-banner bad" role="alert">
      <span class="v-ic">&#10005;</span>
      <div>
        <h1>No clearance found</h1>
        <p>There is no clearance with the code <strong><%= code.slice(0, 20) %></strong>. Check the code and try again. If it is correct, the document may not be genuine.</p>
      </div>
    </div>
    <div class="v-actions"><a class="btn btn-primary" href="/verify">Try another code</a></div>

  <% } else { %>
    <div class="v-banner <%= kind %>" role="status">
      <% if (kind === 'ok') { %>
        <span class="v-ic">&#10003;</span>
        <div>
          <h1>Genuine and complete</h1>
          <p>This clearance was issued by ISU eClearance and every office has signed it<% if (R.completed_at) { %> (completed <%= fmtDate(R.completed_at) %>)<% } %>.</p>
        </div>
      <% } else { %>
        <span class="v-ic">!</span>
        <div>
          <h1>Not complete yet</h1>
          <p>This clearance exists, but some offices have not signed it. <strong>It is not valid until it is complete.</strong></p>
        </div>
      <% } %>
    </div>

    <section class="v-card">
      <h2>Clearance details</h2>
      <dl class="v-info">
        <div><dt>Student</dt><dd><%= [S.last_name + ',', S.first_name, S.middle_name, S.suffix].filter(Boolean).join(' ') %></dd></div>
        <div><dt>Student ID</dt><dd><%= maskedId %></dd></div>
        <div><dt>Program</dt><dd><%= S.program_name || '-' %></dd></div>
        <div><dt>Year level</dt><dd><%= S.year_level ? yrs[S.year_level - 1] : '-' %></dd></div>
        <div><dt>College</dt><dd><%= S.college_name || '-' %></dd></div>
        <div><dt>Purpose</dt><dd><%= R.purpose %></dd></div>
        <div><dt>Term</dt><dd><%= R.school_year %>, <%= R.semester %></dd></div>
        <div><dt>Reference no.</dt><dd><%= R.reference_no %></dd></div>
        <div><dt>Date requested</dt><dd><%= fmtDate(R.created_at) %></dd></div>
        <div><dt>Verification code</dt><dd><%= R.verification_code %></dd></div>
      </dl>
    </section>

    <section class="v-card">
      <h2>Offices</h2>
      <div class="v-scroll">
        <table class="v-table">
          <thead><tr><th>Office / requirement</th><th>Status</th><th>Signed by</th><th>Date</th></tr></thead>
          <tbody>
            <% sheet.items.forEach(function (it) { %>
              <tr>
                <td><strong><%= it.office_name %><% if (it.subject_code) { %> &mdash; <%= it.subject_code %><% } %></strong></td>
                <td><span class="pill <%= pillClass(it.status) %>"><%= statusLabel(it.status) %></span></td>
                <td><%= it.status === 'approved' ? it.signed_name : '-' %></td>
                <td><%= it.status === 'approved' ? fmtDate(it.acted_at) : '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <div class="v-actions"><a class="btn btn-outline" href="/verify">Verify another clearance</a></div>
  <% } %>
</main>

<footer class="v-foot">&copy; <%= new Date().getFullYear() %> Isabela State University &middot; ISU eClearance</footer>

<%- include('../partials/foot') %>