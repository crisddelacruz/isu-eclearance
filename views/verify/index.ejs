<%- include('../partials/head', { title: title, bodyClass: 'verify-page', extraCss: '/css/verify.css' }) %>
<%- include('../partials/verify-header') %>

<main class="v-main">
  <section class="v-hero">
    <span class="v-eyebrow">Verification</span>
    <h1>Verify a clearance</h1>
    <p>Check that a clearance issued through ISU eClearance is genuine.</p>
  </section>

  <section class="v-card v-narrow">
    <form method="get" action="/verify" novalidate>
      <div class="field">
        <label for="code">Verification code</label>
        <input class="input v-code" type="text" id="code" name="code" maxlength="14"
               placeholder="e.g. 3FA9C21B7D" autocomplete="off" autofocus required />
        <p class="hint">10 letters and numbers, printed at the bottom of the clearance.</p>
      </div>
      <button class="btn btn-primary btn-block" type="submit">Verify clearance</button>
    </form>
  </section>

  <section class="v-how">
    <div><b>1</b><h3>Find the code</h3><p>It is printed at the bottom of every clearance, next to the QR code.</p></div>
    <div><b>2</b><h3>Or scan the QR</h3><p>Point your phone camera at the QR code. It opens the result directly.</p></div>
    <div><b>3</b><h3>Read the result</h3><p>A genuine, complete clearance shows a green banner and every office that signed.</p></div>
  </section>
</main>

<footer class="v-foot">&copy; <%= new Date().getFullYear() %> Isabela State University &middot; ISU eClearance</footer>

<%- include('../partials/foot') %>