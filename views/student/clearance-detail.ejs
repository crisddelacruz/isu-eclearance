<%- include('../layouts/app-top', { title: title, active: 'clearance' }) %>

<div class="page-head">
  <a class="link-more" href="/student/clearance">&larr; Back to My Clearance</a>
  <h1 style="margin-top:6px"><%= request.purpose %> Clearance</h1>
  <p>Reference no. <strong><%= request.reference_no %></strong></p>
</div>

<section class="card">
  <div class="card-head">
    <div class="meta-row">
      <div><small>Term</small><strong><%= request.school_year %>, <%= request.semester %></strong></div>
      <div><small>Requested</small><strong><%= fmtDate(request.created_at) %></strong></div>
      <div><small>Verification code</small><strong><%= request.verification_code %></strong></div>
    </div>
    <span class="pill <%= pillClass(request.status) %>"><%= statusLabel(request.status) %></span>
  </div>

  <div class="progress" role="progressbar" aria-valuenow="<%= request.percent %>" aria-valuemin="0" aria-valuemax="100">
    <span style="width: <%= request.percent %>%"></span>
  </div>
  <div class="progress-meta">
    <span><%= request.approved %> of <%= request.total %> signatures</span><span><%= request.percent %>%</span>
  </div>

  <div class="actions" style="margin-top:16px">
    <button class="btn btn-outline btn-sm" type="button" disabled title="PDF download is added in Phase 8">
      <%- icon('download') %> Download PDF (coming in Phase 8)
    </button>

    <% if (request.status === 'in_progress' && request.approved === 0) { %>
      <form class="inline-form" method="post" action="/student/clearance/<%= request.id %>/cancel"
            onsubmit="return confirm('Cancel this clearance request? Its signing list will be deleted.');">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button class="btn btn-danger btn-sm" type="submit">Cancel request</button>
      </form>
    <% } %>
  </div>
</section>

<section class="card">
  <h3>Signing list</h3>
  <p class="card-sub">Every office listed here must sign before your clearance is complete.</p>
  <%- include('_items', { items: items }) %>
</section>

<%- include('../layouts/app-bottom') %>